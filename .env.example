# ==============================================================================
# LLM Security Research Dataset Platform - Environment Configuration
# ==============================================================================

# Database Connection
# In Docker Compose, the database service is named 'db'.
DATABASE_URL=postgresql://postgres:postgres@db:5432/llm_security

# For running backend directly on Linux/WSL with local PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llm_security

# For running local tests with SQLite without running Postgres daemon:
# DATABASE_URL=sqlite:///./dataset/security_research.db

# API Configuration
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8001
HOST_PORT=8001
PAGE_SIZE_DEFAULT=50
PAGE_SIZE_MAX=200
